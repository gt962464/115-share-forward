# Telegram 用户账号 API 凭据：到 https://my.telegram.org 获取
TG_API_ID=
TG_API_HASH=

# 首次登录用手机号；已生成 session 后可留空
TG_PHONE=+8613812345678
# 必须放在持久化目录；不要提交、不要发给任何人
TG_SESSION=/tg-monitor-state/user

# 来源私聊：可填机器人用户名（如 @source_bot），或数字 chat/user ID
TG_SOURCE_CHAT=@source_bot

# 转交目标：填现有 cardbot 的私聊 chat ID，通常就是你的 Telegram 用户 ID
TG_FORWARD_TO=123456789

# 现有卡片机器人的 BotFather Token（不要使用来源机器人的 Token）
TG_BOT_TOKEN=

# 访问 Telegram 时的代理；海外服务器通常无需代理，留空即可
TG_PROXY=

# 只监听此消息 ID 之后的新消息；0 表示从现在开始
TG_START_FROM=0
TG_FORWARD_TIMEOUT=30
TG_MONITOR_WEB_HOST=0.0.0.0
TG_MONITOR_WEB_PORT=18800
# 可选：网页密钥；设置后需通过 X-Monitor-Secret 请求头访问
TG_MONITOR_WEB_SECRET=
LOG_LEVEL=INFO
