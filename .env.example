# ============================================
# 115 分享转存机器人 v2 · 环境变量配置
# 可以直接在 Bot 里通过 /set 命令修改
# ============================================

# ── 最小启动配置（至少填这两个）──
TG_BOT_TOKEN=
TG_USER_ID=

# ── 115 ──
P115_COOKIE=
P115_SAVE_DIR=自动转存

# ── Telegram ──
TG_CHANNEL_ID=
TG_ADMIN_IDS=
TG_ALLOW_SUBMIT_IDS=

# ── Telethon 监听 ──
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION=/data/user.session
TG_MONITOR_TARGETS=
TG_MONITOR_MODE=private
# 首次登录临时用（登录成功后删除再重启）：
# TG_LOGIN_CODE=
# TG_LOGIN_PASSWORD=

# ── 代理 ──
TG_PROXY=
APP_HTTP_PROXY=

# ── 行为 ──
LOG_LEVEL=INFO
AUTO_RENAME=1
# 发卡成功后自动删除源文件（秒，0=不删除）。⚠️ 删除后分享链接会失效！
AUTO_DELETE_AFTER=0
# 115 回收站密码（清空回收站用，自动/手动清理都需要）
RECYCLE_PASSWORD=
SHARE_AUDIT_WAIT_TIMEOUT=900
SHARE_AUDIT_POLL_INTERVAL=30
RETRY_INTERVAL=60
MAX_RETRY=3

# ── TMDB ──
TMDB_API_KEY=
TMDB_LANG=zh-CN

# ── OpenAI 辅助识别（也可在 Bot「🤖 OpenAI」按钮里改，立即生效）──
LLM_API_BASE=https://apihub.agnes-ai.com/v1
LLM_API_KEY=
LLM_MODEL=agnes-2.5-flash
# 自定义识别提示词（留空=内置默认）：
# LLM_PROMPT=
