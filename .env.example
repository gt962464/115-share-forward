# ============================================
# 115 分享转发 · 服务器部署环境变量模板
# 复制为 .env 后填写实际值
# ============================================

# ── 核心必填 ──
P115_COOKIE=
TG_BOT_TOKEN=
TG_CHANNEL_ID=

# ── 可选（不填功能降级）──
TG_USER_ID=
TG_ALLOW_CHATS=
TMDB_API_KEY=
TMDB_LANG=zh-CN
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# ── 网络代理（按需）──
TG_PROXY=
APP_HTTP_PROXY=

# ── 行为配置 ──
P115_SAVE_DIR=自动转存
LOG_LEVEL=INFO
AUTO_PROCESS_115_LINKS=1
AUTO_DELETE_AFTER=0
RECYCLE_PASSWORD=

# ── 管理后台密码 ──
ADMIN_PASSWORD=change-this-password
ADMIN_SECRET=