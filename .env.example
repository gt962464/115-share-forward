# ============================================
# 115 分享转发 · 服务器部署环境变量模板
# 复制为 .env 后填写实际值
# ============================================

# ── 核心必填 ──
P115_COOKIE=
TG_BOT_TOKEN=
TG_CHANNEL_ID=

# ── 可选（不填功能降级）──
TG_USER_ID=
TG_ALLOW_CHATS=
TG_SUBMITTER_IDS=
TMDB_API_KEY=
TMDB_LANG=zh-CN
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# ── 网络代理（按需）──
TG_PROXY=
APP_HTTP_PROXY=

# ── 行为配置 ──
P115_SAVE_DIR=自动转存
LOG_LEVEL=INFO
AUTO_PROCESS_115_LINKS=1
AUTO_DELETE_AFTER=0
RECYCLE_PASSWORD=
# 测试模式：0=正常（转存+重命名+发频道）；1/2=测试（不转存、直接发原链接）。生产必须 0
CARD_BOT_TEST_MODE=0

# ── 管理后台密码 ──
ADMIN_PASSWORD=change-this-password
ADMIN_SECRET=

# ── Telegram 监听转发（tg-monitor，可选）──
# 用你的真实 Telegram 用户账号监听来源聊天，把 115 链接转发给卡片机器人。
# 需要到 https://my.telegram.org 创建应用，取得 api_id / api_hash。
TG_API_ID=
TG_API_HASH=
# 首次登录用手机号（+区号格式）；登录成功生成 session 后可留空
TG_PHONE=
# 来源聊天：发 115 链接的机器人/频道（@用户名 或数字 ID）
TG_SOURCE_CHAT=
# 转发目标：卡片机器人接收的聊天 ID（通常就是你自己的 Telegram 用户 ID，给卡片机器人发 /id 查看）
TG_FORWARD_TO=