# ===== 115 资源卡片机器人 配置模板 =====
# 复制为 .env 并填入你自己的值。敏感值绝不要发到聊天/截图/代码仓库。

# 【必填】115 登录 Cookie（与 P115-Share 里填的同一个）
# 在浏览器登录 115 后，从开发者工具 Network 请求头里复制 Cookie 整段。
P115_COOKIE=

# 115 转存后保存到的目录名（不存在会自动建）
P115_SAVE_DIR=115-Share

# 【必填】Telegram 机器人 Token（@BotFather 创建）
TG_BOT_TOKEN=

# 【必填】卡片发布的频道 ID（负数，如 -1001234567890）
# 机器人必须是该频道管理员且具备发帖权限
TG_CHANNEL_ID=

# 管理员 TG 用户 ID（用于白名单与异常通知，可选）
TG_USER_ID=

# 允许使用的聊天 ID 白名单，逗号分隔。留空=不限制。
TG_ALLOW_CHATS=

# TMDB API Key（可选）。不填则卡片无海报/评分/简介，仅做文件名解析卡片。
# 申请：https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# 语言（TMDB 简介/类型），默认中文
TMDB_LANG=zh-CN

# Telegram Bot 代理（如果你的 NAS 访问 TG 需要代理，可选）
# 例：socks5://192.168.31.18:7893
TG_PROXY=

# 给 TMDB/豆瓣/海报下载用的 HTTP 代理（可选）
# 例：http://192.168.31.18:7890
APP_HTTP_PROXY=

# 115 回收站密码（频道发送成功后立即清理任务目录并清空回收站；敏感值不要提交或同步到桌面）
RECYCLE_PASSWORD=
# 频道发送成功后延迟清理秒数，默认0=立即清理
AUTO_DELETE_AFTER=0

# 日志级别
LOG_LEVEL=INFO

# ── 测试模式 ───────────────────────────────────────────────
# 0=正常（转存+发频道），1=纯解析+私聊出卡片（不调115），2=调115取信息但仍私聊出卡片（不发频道）
# 推荐：测试模板期间先用 1，等满意后再切 0
CARD_BOT_TEST_MODE=1

# ── LLM 辅助识别（可选，推荐启用）────────────────────────────
# 用于文件名歧义/误写修正（如 HiveWeb 直译英文名、源文件名错别字）
# 支持任何 OpenAI 兼容接口（OpenAI / Claude / 智谱 / 硅基流动 等）
# 不填则跳过 LLM 辅助，仅用正则+别名+TMDB 识别
LLM_API_BASE=https://apihub.agnes-ai.com/v1
LLM_API_KEY=
LLM_MODEL=agnes-2.5-flash
